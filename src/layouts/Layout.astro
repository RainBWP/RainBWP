---
import '../global.css';
import Navbar from '../components/layout/nav.astro';
import Footer from '../components/layout/footer.astro';

interface Props{
	title?: string;
}

const {
	title = 'RainBW'
} = Astro.props
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=fit" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.webp" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<Navbar />
		<slot />
		<Footer />
	</body>
	
</html>
