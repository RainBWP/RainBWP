---
interface Props {
    /** Texto visible. Si se omite, el boton es solo icono y `label` es obligatorio. */
    text?: string;
    /** Icono (svg importado). Solo uno a la vez; se pinta con el color de texto. */
    icon?: ImageMetadata;
    /** Nombre accesible para botones de solo icono. */
    label?: string;
    href?: string;
    type?: 'button' | 'submit' | 'reset';
    action?: string;
    disabled?: boolean;
    newTab?: boolean;
    download?: boolean;
    /** @deprecated el nuevo diseno solo tiene un estilo de boton. */
    variant?: 'primary' | 'secondary';
}

const {
    text,
    icon,
    label,
    href,
    type = 'button',
    action,
    disabled = false,
    newTab = false,
    download = false,
} = Astro.props;

const iconStyle = icon ? `--boton-icon: url("${icon.src}")` : undefined;
---

{
    href && !disabled ? (
        <a class="boton"
            href={href}
            target={newTab ? '_blank' : undefined}
            rel={newTab ? 'noopener noreferrer' : undefined}
            download={download}
            aria-label={label}
            >
            {icon && <span class="boton-icon" style={iconStyle} aria-hidden="true"></span>}
            {text}
        </a>
    ) : (
        <button
            class="boton"
            type={type}
            data-action={action}
            disabled={disabled}
            aria-label={label}
        >
            {icon && <span class="boton-icon" style={iconStyle} aria-hidden="true"></span>}
            {text}
        </button>
    )
}


<style>
    /* Sin sombras, nunca. */
    .boton {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
        padding: 10px 30px;

        border: 5px solid var(--accent-color);
        border-radius: 0;
        background: var(--background-color);
        color: var(--text-color);

        font-family: var(--font-text);
        font-size: 16px;
        font-weight: 700;
        line-height: normal;
        text-align: center;
        text-decoration: none;
        white-space: nowrap;
        cursor: pointer;
    }

    .boton:hover {
        border-color: var(--text-color);
    }

    .boton:focus-visible {
        outline: 2px solid var(--accent-color);
        outline-offset: 2px;
    }

    .boton:disabled {
        border-color: var(--disable-color);
        color: var(--disable-color);
        cursor: not-allowed;
    }

    /* El marco del icono siempre mide 20px y toma el color del texto. */
    .boton-icon {
        flex: 0 0 20px;
        width: 20px;
        height: 20px;
        background: currentColor;
        -webkit-mask: var(--boton-icon) center / 100% 100% no-repeat;
        mask: var(--boton-icon) center / 100% 100% no-repeat;
    }
</style>
