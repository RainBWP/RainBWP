---
import { undefined } from 'astro:schema';

interface Props {
    text: string;
    href?: string;
    variant?: 'primary' | 'secondary';
    type?: 'button' | 'submit' | 'reset';
    action?: string;
    disabled?: boolean;
    newTab?: boolean;
}

const {
    text,
    href,
    variant = 'primary',
    type = 'button',
    action,
    disabled = false,
    newTab=false,
} = Astro.props;
---

{
    href ? (
        <a class={`boton boton-${variant}`} 
            href={href}
            target={newTab? '_blank' : '_self'}
            rel={newTab ? 'noopener noreferrer' : 'null'}
            >
            {text}
        </a>
    ) : (
        <button
            class={`boton boton-${variant}`}
            type={type}
            data-action={action}
            disabled={disabled}
        >
            {text}
        </button>
    )
}


<style>
    .boton {
        display: flex;
        min-height: 30px;
        min-width: 80px;
        padding: 5px 50px 5px 20px;
        justify-content: left;
        align-items: left;
        gap: 10px;

        box-shadow: var(--shadow-border, 2px 2px 0 0 rgba(0, 0, 0, 0.25));

        text-decoration: none;
        text-align: left;
        font-size: 16px;
        font-style: normal;
        font-weight: 500;
        line-height: normal;
        
    }

    .boton:hover{
        
    }
    .boton-primary {
        border: 4px solid var(--color-accent, #4C4E7D);
        background: var(--color-surface, #AEE3FC);
        color: var(--color-accent, #4C4E7D);
    }
    .boton-secondary {
        border: 4px solid var(--color-background, #FEF6E6);
        background: var(--color-accent);
        color: var(--color-background, #FEF6E6);

    }

    .boton-primary:hover {
        border: 4px solid var(--color-surface);
        background: var(--color-accent);
        color: var(--color-surface);
    }
    .boton-secondary:hover {
        border: 4px solid var(--color-accent);
        background: var(--color-background);
        color: var(--color-accent);

    }
    .boton:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }



</style>