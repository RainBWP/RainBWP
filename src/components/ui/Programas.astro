---
interface Props {
	titulo: string;
	descripcion: string;
}

const { titulo, descripcion } = Astro.props;
---

<article class="programas">
	<div class="programas-iconos">
		<slot name="iconos" />
	</div>
	<h3>{titulo}</h3>
	<p hidden>{descripcion}</p>
</article>

<style>
	.programas {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		width: 100%;
	}

	.programas-iconos {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		align-content: center;
		align-items: center;
		gap: 10px;
	}

	h3 {
		text-align: right;
	}

	p {
		text-align: justify;
	}
</style>
