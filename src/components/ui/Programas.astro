---
interface Props {
	titulo: string;
	descripcion: string;
}

const { titulo, descripcion } = Astro.props;
---

<section class="programas">
	<div class="programas-iconos">
		<slot name="iconos" />
	</div>

	<div class="programas-linea" aria-hidden="true"></div>

	<h2>{titulo}</h2>
	<p>{descripcion}</p>
</section>

<style>
	.programas {
        display: flex;
        padding: 20px;
        flex-direction: column;
        justify-content: flex-end;
        align-items: center;
        gap: 10px;
        width: min(300px, 100%);
        box-sizing: border-box;
	}

	.programas-iconos {
		display: flex;
		align-items: center;
		justify-content: center;
		flex-wrap: wrap;
		gap: 10px;
		width: min(300px, 100%);
		padding: 10px;
		box-sizing: border-box;
	}

	.programas-iconos :global(.icono) {
		display: block;
		flex: 0 0 40px;
		width: 40px;
		height: 40px;
		box-sizing: border-box;
		background: var(--main, #FCE4AF);
		object-fit: contain;
		transition: transform 0.2s ease-in-out;
		transform-origin: center;
        box-shadow: var(--shadow-border, 2px 2px 0 0 rgba(0, 0, 0, 0.25));
	}

	.programas-iconos :global(.icono:hover) {
		transform: scale(1.1);
	}

	.programas-linea {
		width: min(300px, 100%);
		height: 5px;
		background: var(--secondary, #AEB1FC);
		box-shadow: 2px 2px 0 rgba(0, 0, 0, 0.25);
	}

	h2 {
		margin: 0;
		color: var(--dark, #151622);
		font-family: 'Saira', sans-serif;
		font-size: 20px;
		font-weight: 600;
		line-height: 1;
		text-align: center;
		text-transform: capitalize;
	}

	p {
		width: max(300px, 100%);
		height: 50px;
		margin: 0;
		color: var(--dark, #151622);
		font-family: 'Saira Condensed', sans-serif;
		font-size: 14px;
		font-weight: 400;
		line-height: normal;
		text-align: center;
	}
</style>
