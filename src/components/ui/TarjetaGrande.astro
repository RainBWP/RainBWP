---
import { Image } from 'astro:assets';

interface Props {
	titulo: string;
	contenido: string;
	imagen: ImageMetadata;
	imagenAlt?: string;
}

const { titulo, contenido, imagen, imagenAlt = '' } = Astro.props;
---

<article class="tarjeta">
	<Image
		class="tarjeta-imagen"
		src={imagen}
		alt={imagenAlt}
		widths={[400, 700, 1400]}
		sizes="(min-width: 700px) 700px, 100vw"
	/>
	<h3>{titulo}</h3>
	<div class="tarjeta-acciones">
		<slot name="acciones" />
	</div>
	<p class="tarjeta-contenido">{contenido}</p>
</article>

<style>
	.tarjeta {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		width: 100%;
		text-align: right;
		
	}

	/* Las miniaturas siempre van en 16:9. */
	.tarjeta-imagen {
		width: 100%;
		height: auto;
		object-fit: cover;
	}

	.tarjeta-acciones {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		align-items: center;
		gap: 20px;
		padding-block: 10px;
	}
	.tarjeta-contenido {
		text-align: justify;
    	text-align-last: right;
	}
</style>
