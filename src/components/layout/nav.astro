---
import GithubIcon from '../../assets/icons/Github.svg';
---

<nav class="nav" aria-label="Navegación principal">
    <h4 class="logo-text" >RBW - Dimi</h4>
    <div class="nav-links" hidden>
        <a href="#inicio">Productos</a>
    </div>
    <div class="links-buttons" >
        <a class="button-href" href="https://github.com/RainBWP" aria-label="GitHub"><GithubIcon /></a>
    </div>
</nav>

<style>
    .nav {

        display: flex;
        width: min(calc(100% - 20px),1200px);
        height: 70px;
        padding: 10px 40px;
        justify-content: space-between;
        align-items: center;
        gap: 63px;

        /* Floating inset kept on purpose (iOS liquid glass look): don't snap to top: 0 */
        position: fixed;
        top: 5px;
        left: 50vw;
        z-index: 1000;

        min-height: 48px;

        transform: translateX(-50%);
        box-sizing: border-box;

        border-radius: 0;
        border: 4px solid var(--color-accent, #4C4E7D);
        background: var(--color-surface, #AEE3FC);

        box-shadow: var(--shadow-border, 4px 4px 0 0 rgba(0, 0, 0, 0.25));
    }

    .nav a {
        color: var(--extra, #4C4E7D);
        text-align: center;
        leading-trim: both;
        text-edge: cap;

        /* Enlaces */
        font-family: 'Saira', sans-serif;
        font-size: 16px;
        font-style: italic;
        font-weight: 100;
        line-height: normal;
        text-decoration-line: underline;
        text-decoration-style: solid;
        text-decoration-skip-ink: auto;
        text-decoration-thickness: auto;
        text-underline-offset: auto;
        text-underline-position: from-font;
        text-transform: capitalize;
    }

    .nav a:hover {
        color: var(--color-text, #151622);
    }

    .nav a:focus-visible {
        outline: 3px solid var(--dark, #151622);
        outline-offset: 3px;
    }

    .logo-text {
        /* Headline 4 */
        color: var(--color-accent, #4C4E7D);
        leading-trim: both;
        text-edge: cap;

        /* Headline 4 */
        font-family: 'Saira Condensed',sans-serif;
        font-size: 20px;
        font-style: normal;
        font-weight: 600;
        line-height: normal;
        text-transform: capitalize;
        width: max(20%,100px);
    }

    .nav-links {
        display: flex;
        justify-content: center;
        align-items: center;
        flex: 1 0 0;
    }
    .links-buttons{
        width: max(20%,50px);
        display: flex;
        flex-direction: row;
        flex-wrap: nowrap;
        justify-content: right;
    }
    .button-href{
        display: block;
        width: 40px;
        height: 40px;
        margin: 0;
        padding: 0;
        background: var(--main, #FCE4AF);
        box-shadow: var(--shadow-border, 4px 4px 0 0 rgba(0, 0, 0, 0.25));
        transition: transform 0.2s ease-in-out;
        transform-origin: center;
    }
    .button-href:hover {
        transform: scale(1.1);
    }
    .button-href :global(svg) {
        display: block;
        width: 100%;
        height: 100%;
    }

    /* Phone layout */
    @media (max-width: 700px) {
        .nav {
            gap:20px;
            padding: 10px 20px;
        }
        .nav-links {
            display: none;
        }
    }
</style>
