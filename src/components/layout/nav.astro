---
import GithubIcon from '../../assets/icons/Github.svg';
---

<nav class="nav" aria-label="Navegación principal">
    <h4 class="logo-text">RBW - Dimi</h4>
    <div class="nav-links" hidden>
        <a class="nav-link" href="#inicio">Productos</a>
    </div>
    <div class="links-buttons">
        <a class="button-href" href="https://github.com/RainBWP" aria-label="GitHub"><GithubIcon /></a>
    </div>
</nav>

<style>
    .nav {
        display: flex;
        width: min(calc(100% - 20px), var(--size-content, 1200px));
        height: var(--size-nav, 70px);
        padding: var(--space-2, 10px) var(--space-5, 40px);
        justify-content: space-between;
        align-items: center;
        gap: var(--space-6, 50px);

        position: fixed;
        top: 5px;
        left: 50vw;
        z-index: 1000;
        transform: translateX(-50%);
        box-sizing: border-box;

        border-radius: var(--radius-none, 0);
        border: var(--size-border, 2px) solid var(--color-accent, #4c4e7d);
        background: var(--color-surface, #aee3fc);
        box-shadow: var(--shadow-border, 4px 4px 0 0 rgba(0, 0, 0, 0.25));
    }

    .logo-text {
        margin: 0;
        width: max(20%, 100px);
        color: var(--color-accent, #4c4e7d);
        font-family: 'Saira Condensed', sans-serif;
        font-size: 20px;
        font-weight: 600;
        line-height: 1;
        text-transform: capitalize;
    }

    .nav-links {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: var(--space-3, 20px);
        flex: 1 0 0;
    }

    .nav-link {
        color: var(--extra, #4c4e7d);
        font-family: 'Saira Condensed', sans-serif;
        font-size: 16px;
        font-weight: 400;
        text-decoration: underline;
        text-underline-offset: 3px;
        text-transform: capitalize;
    }

    .nav-link:hover {
        color: var(--color-text, #151622);
    }

    .links-buttons {
        width: max(20%, 50px);
        display: flex;
        justify-content: flex-end;
    }

    .button-href {
        display: block;
        width: var(--size-icon, 40px);
        height: var(--size-icon, 40px);
        background: none;
        filter: drop-shadow(4px 4px 0 rgba(0, 0, 0, 0.25));
        transition: transform 0.2s ease-in-out;
    }

    .button-href:hover {
        transform: scale(1.1);
    }

    .button-href :global(svg) {
        display: block;
        width: 100%;
        height: 100%;
    }

    .nav a:focus-visible {
        outline: 3px solid var(--dark, #151622);
        outline-offset: 3px;
    }

    @media (max-width: 700px) {
        .nav {
            gap: var(--space-3, 20px);
            padding: var(--space-2, 10px) var(--space-3, 20px);
        }
        .nav-links {
            display: none;
        }
    }
</style>