        <li><a href="/licencias">Licencias</a></li>
    </ul>
    <p class="footer-copyright">@rainbwp</p>
</footer>

<script>
    // Safari pinta sus barras y el rebote del scroll con el fondo de html/body.
    // Cuando el footer esta por llegar al borde inferior de la pantalla se marca
    // data-bottom="footer" y ese fondo pasa a ser el del footer (CSS de abajo).
    const footer = document.querySelector('.footer');

    if (footer) {
        let pending = false;

        const update = () => {
            pending = false;
            const rect = footer.getBoundingClientRect();
            // Se adelanta una pantalla: en un swipe rapido el cambio tiene que estar
            // pintado antes de que empiece el rebote.
            const lookahead = window.innerHeight * 2;
            const atBottomEdge = rect.top < window.innerHeight + lookahead && rect.bottom >= window.innerHeight - 1;

            // scrollY > 0: en paginas que no hacen scroll no se cambia nada.
            if (window.scrollY > 0 && atBottomEdge) {
                document.documentElement.dataset.bottom = 'footer';
            } else {
                delete document.documentElement.dataset.bottom;
            }
        };

        const schedule = () => {
            if (pending) return;
            pending = true;
            requestAnimationFrame(update);
        };

        window.addEventListener('scroll', schedule, { passive: true });
        window.addEventListener('resize', schedule);
        update();
    }
</script>

<style is:global>
    html[data-bottom="footer"],
    html[data-bottom="footer"] body {
        background: var(--text-color);
    }
</style>

