---
import Programas from '../ui/Programas.astro';

// Importar Iconos SVG
import AffinityStudio from '../../assets/icons/affinity-studio.svg';
import AfterEffects from '../../assets/icons/AfterEffects.svg';
import AstroIcon from '../../assets/icons/AstroIcon.svg';
import Audition from '../../assets/icons/Audition.svg';
import Cloudflare from '../../assets/icons/Cloudflare.svg';
import Css from '../../assets/icons/css.svg';
import DaVinciResolve from '../../assets/icons/DaVinciResolve.svg';
import Ffmpeg from '../../assets/icons/FFMPEG.svg';
import Figma from '../../assets/icons/Figma.svg';
import FlStudio from '../../assets/icons/FLStudio.svg';
import Flutter from '../../assets/icons/Flutter.svg';
import Html from '../../assets/icons/html.svg';
import Illustrator from '../../assets/icons/Illustrator.svg';
import Java from '../../assets/icons/Java.svg';
import JavaScript from '../../assets/icons/JavaScript.svg';
import LogicPro from '../../assets/icons/Logic Pro.svg';
import NodeJs from '../../assets/icons/NodeJs.svg';
import Photoshop from '../../assets/icons/Photoshop.svg';
import PremierPro from '../../assets/icons/Premier Pro.svg';
import Python from '../../assets/icons/Python.svg';
import React from '../../assets/icons/React.svg';
import Vue from '../../assets/icons/Vue.svg';

const programacion = [
    { src: Css.src, alt: 'CSS' },
    { src: Html.src, alt: 'HTML' },
    { src: Vue.src, alt: 'Vue' },
    { src: React.src, alt: 'React' },
    { src: Python.src, alt: 'Python' },
    { src: NodeJs.src, alt: 'Node.js' },
    { src: JavaScript.src, alt: 'JavaScript' },
    { src: Ffmpeg.src, alt: 'FFmpeg' },
    { src: Cloudflare.src, alt: 'Cloudflare' },
    { src: Java.src, alt: 'Java' },
    { src: Flutter.src, alt: 'Flutter' },
    { src: AstroIcon.src, alt: 'Astro' },
];

const creatividad = [
    { src: AffinityStudio.src, alt: 'Affinity Studio' },
    { src: Figma.src, alt: 'Figma' },
    { src: Photoshop.src, alt: 'Photoshop' },
    { src: Illustrator.src, alt: 'Illustrator' },
    { src: DaVinciResolve.src, alt: 'DaVinci Resolve' },
    { src: PremierPro.src, alt: 'Premiere Pro' },
    { src: FlStudio.src, alt: 'FL Studio' },
    { src: LogicPro.src, alt: 'Logic Pro' },
    { src: AfterEffects.src, alt: 'After Effects' },
    { src: Audition.src, alt: 'Audition' },
];
---

<section id="mis-habilidades">
    <h2>mis habilidades</h2>

    <Programas
        titulo="programacion"
        descripcion="hay que saber escribir lo que yo quiera"
    >
        {programacion.map((icono) => (
            <img class="icono" src={icono.src} alt={icono.alt} title={icono.alt} width="40" height="40" slot="iconos" />
        ))}
    </Programas>

    <Programas
        titulo="creatividad"
        descripcion="hay que saber escribir lo que yo quiera"
    >
        {creatividad.map((icono) => (
            <img class="icono" src={icono.src} alt={icono.alt} title={icono.alt} width="40" height="40" slot="iconos" />
        ))}
    </Programas>
</section>
