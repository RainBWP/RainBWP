---
// Hero de todas las paginas (index, musica, licencias, errores): colores
// invertidos respecto al resto de la pagina y a pantalla completa.
interface Props {
    /** Linea chica de arriba, p. ej. "ummmm..." */
    kicker: string;
    /** Texto gigante. */
    title: string | number;
    /** Linea de abajo. */
    subtitle?: string;
    /** Tamano del titulo si el texto no cabe a 128px, p. ej. "clamp(72px, 22vw, 128px)". */
    titleSize?: string;
    /** id de la seccion a la que baja la flecha, p. ej. "mi-musica". Sin esto no hay flecha. */
    scrollTo?: string;
    /** Nombre accesible de la flecha. */
    scrollLabel?: string;
    /** id del propio hero, p. ej. "inicio". */
    id?: string;
}

const { kicker, title, subtitle, titleSize, scrollTo, scrollLabel = 'Bajar al contenido', id } = Astro.props;
---

<section id={id} class="page-hero" style={titleSize ? `--hero-title-size: ${titleSize}` : undefined}>
    <div class="page-hero-figure" aria-hidden="true">
        <span class="page-hero-silhouette"></span>
    </div>

    <div class="page-hero-text">
        <p class="heading-hero">{kicker}</p>
        <h1>{title}</h1>
        {subtitle && <p class="page-hero-subtitle">{subtitle}</p>}
    </div>

    {/* Lo que se ponga dentro de <PageHero>...</PageHero> (botones, enlaces,
        cualquier HTML) sale aqui, debajo del texto. */}
    {Astro.slots.has('default') && (
        <div class="page-hero-extra">
            <slot />
        </div>
    )}

    {scrollTo && (
        <a class="page-hero-scroll" href={`#${scrollTo}`} aria-label={scrollLabel}>
            <span class="page-hero-chevron" aria-hidden="true"></span>
        </a>
    )}
</section>

<script>
    // Safari pinta la barra superior y el rebote del scroll con el fondo de html/body.
    // Mientras el hero esta bajo el borde superior, ese fondo es el del hero (CSS de abajo);
    // al pasarlo se marca data-top="page" y vuelve el fondo general.
    const hero = document.querySelector('.page-hero');

    if (hero) {
        const observer = new IntersectionObserver(
            ([entry]) => {
                if (entry.isIntersecting) {
                    delete document.documentElement.dataset.top;
                } else {
                    document.documentElement.dataset.top = 'page';
                }
            },
            // Linea de 1px en el borde superior de la pantalla.
            { rootMargin: '0px 0px -100% 0px' }
        );
        observer.observe(hero);
    }
</script>

<style is:global>
    /* Solo aplica en paginas que tienen el hero. */
    html:has(.page-hero):not([data-top="page"]),
    html:has(.page-hero):not([data-top="page"]) body {
        background: var(--text-color);
    }
</style>

<style>
    /* El hero invierte los colores de la pagina y ocupa toda la pantalla. */
    .page-hero {
        --gutter: 20px;
        min-height: 80vh;
        min-height: 80svh;
        justify-content: flex-end;
        gap: 19px;
        padding-top: 100px;
        padding-bottom: 20px;
        overflow: clip;
        background: var(--text-color);
        color: var(--background-color);
    }

    /* En escritorio el contenido va centrado verticalmente. */
    @media (min-width: 1000px) {
        .page-hero {
            justify-content: center;
        }
    }

    .page-hero-figure {
        position: relative;
        align-self: stretch;
        height: 178px;
    }

    /* Se sale por la derecha y se mete un poco detras del texto, como en el diseno.
       Crece de forma fluida con el ancho de la ventana: 279px en telefono (393px)
       hasta 586px en escritorio (1440px), los dos tamanos del Figma. */
    .page-hero-silhouette {
        --grow: calc(100vw - 393px);
        position: absolute;
        top: clamp(-13.5px, calc(-3px - var(--grow) * 0.01), -3px);
        right: clamp(-217.5px, calc(-73.5px - var(--grow) * 0.1375), -73.5px);
        width: clamp(279px, calc(279px + var(--grow) * 0.2932), 586px);
        aspect-ratio: 279 / 219;
        background: url('../../assets/ui/light-dimi.svg') center / 100% 100% no-repeat;
    }

    @media (prefers-color-scheme: dark) {
        .page-hero-silhouette {
            background-image: url('../../assets/ui/dark-dimi.svg');
        }
    }

    /* Columna de 353px como en el Figma: asi el texto hace salto de linea
       antes de meterse debajo del dimi. */
    .page-hero-text {
        position: relative;
        width: 100%;
        max-width: 353px;
    }

    h1 {
        font-size: var(--hero-title-size, 128px);
        font-weight: 1000;
        line-height: 0.8;
    }

    .page-hero-subtitle {
        font-size: 32px;
    }

    /* Botones y demas contenido propio de cada pagina. */
    .page-hero-extra {
        position: relative;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 20px;
    }

    /* Flecha hacia abajo, centrada al pie del hero. */
    .page-hero-scroll {
        display: flex;
        justify-content: center;
        align-items: center;
        align-self: stretch;
        height: 20px;
    }

    .page-hero-chevron {
        width: 8.667px;
        height: 5.333px;
        background: currentColor;
        -webkit-mask: url('../../assets/ui/chevron-down.svg') center / 100% 100% no-repeat;
        mask: url('../../assets/ui/chevron-down.svg') center / 100% 100% no-repeat;
    }
</style>
