---
import PageHero from './PageHero.astro';
import Boton from '../ui/Button.astro';
import GithubIcon from '../../assets/ui/github.svg';
import LinkedinIcon from '../../assets/ui/linkedin.svg';
---

<PageHero
    id="inicio"
    kicker="hola, yo soy"
    title="ELIEL"
    subtitle="ingeniero en ciencias de la computacion"
    scrollTo="sobre-mi"
    scrollLabel="Bajar a algo de mi"
>
    <Boton text="github"
        icon={GithubIcon}
        href="https://github.com/RainBWP"
        newTab
        />
    <Boton text="linkedin"
        icon={LinkedinIcon}
        href="https://www.linkedin.com/in/elielm-aquino/"
        newTab
        />
</PageHero>
