---
import Boton from '../ui/Button.astro';
import HeroImage from '../../assets/images/hero-image.jpg';
---

<section id="inicio" class="inicio">
    <div class="hero-image-container">
        <img class="hero-image" src={HeroImage.src} alt="Hero Image" />
    </div>
    <div class="hero">
        <h3 class="subtitle">Hola, soy Eliel</h3>
        <h1 class="title">Programador / diseñador uX UI</h1>
        <p class="description">Especialista en desarrollo frontend y backend, infraestructura local, sistemas IoT y soporte de hardware, con rápida adaptabilidad técnica.</p>
        <div class="links-buttons">
            <Boton text="Correo" href="mailto:rain@rainbwp.com" variant="secondary"/>
            <Boton text="Linkedin" href="https://www.linkedin.com/in/elielm-aquino/" variant="secondary"/>
            <Boton text="Github" href="https://github.com/RainBWP"  />
        </div>
    </div>
    
</section>

<style>
    *{
        margin: 0;
        padding: 0;
    }
    .inicio {
        display: flex;
        flex-wrap: wrap;
        flex-direction: row-reverse;
        width: 100%;
        min-height: 500px;
        padding: 10px;
        justify-content: center;
        align-items: center;
        gap: 50px;
        align-self: stretch;
    }
    .links-buttons {
        display: flex;
        flex-wrap: wrap;
        padding: 10px;
        justify-content: flex-end;
        align-items: flex-start;
        gap: 10px;
        align-self: stretch;
    }
    .description {
        max-width: 400px;
        text-align: right;
        line-height: 1.5;
        leading-trim: both;
        text-edge: cap;
    }
    .title {
        color: var(--color-accent);
        text-align: right;
        leading-trim: both;
        text-edge: cap;
        align-self: stretch;
    }
    .subtitle {
        text-align: right;
        leading-trim: both;
        text-edge: cap;
        color: var(--color-secondary);
        align-self: stretch;
    }
    .hero {
        display: flex;
        min-height: 200px;
        flex-direction: column;
        justify-content: center;
        align-items: flex-end;
        gap: 13px;
    }
    .hero-image-container {
        position: relative;
        width: 300px;
        height: 300px;
        border-radius: 50%;
        overflow: hidden;
    }

    .hero-image-container::after {
        content: '';
        position: absolute;
        inset: 0;
        z-index: 1;
        border-radius: inherit;
        box-shadow: inset var(--shadow-border, 2px 2px 0 0 rgba(0, 0, 0, 0.25));
        pointer-events: none;
    }

    .hero-image {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
    }

    @media (max-width: 650px) {
        .inicio {
            flex-direction: column;
            align-items: center;
            text-align: center;
        }
        .hero {
            align-items: center;
        }
        .description, .title, .subtitle {
            text-align: center;
        }
        .links-buttons {
            justify-content: center;
        }
        .hero-image-container {
            width: 200px;
            height: 200px;
        }
    }
</style>