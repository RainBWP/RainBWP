---
import TarjetaGrande from '../ui/TarjetaGrande.astro';
import Boton from '../ui/Button.astro';

import SihelpmsThumbnail from '../../assets/images/sihelpms.png';
import GearmoneyThumbnail from '../../assets/images/gearmoney.png';

import GithubIcon from '../../assets/ui/github.svg';
---

<section id="mis-proyectos">
    <h2>mis proyectos</h2>

    <TarjetaGrande
        titulo="SIHELPMS"
        contenido="extensión para navegador orientada a facilitar tareas administrativas dentro de SISEEMS. El popup permite introducir CURPs o números de control y ejecutar acciones sobre la pestaña activa de SISEEMS."
        imagen={SihelpmsThumbnail}
        imagenAlt="SIHELPMS"
        >
        {/* TODO: poner los enlaces reales de descarga y repositorio de SIHELPMS */}
        <Boton slot="acciones" text="download" href="https://github.com/RainBWP/SIHELPMS/releases" newTab />
        <Boton slot="acciones" icon={GithubIcon} label="Codigo fuente de SIHELPMS en GitHub" href="https://github.com/RainBWP/SIHELPMS" newTab />
    </TarjetaGrande>

    <TarjetaGrande
        titulo="gearmoney"
        contenido="aplicación hecha enteramente en Flutter como proyecto final.Encargado de la UX y UI en diseño, y control de calidad en el mismo."
        imagen={GearmoneyThumbnail}
        imagenAlt="Gearmoney"
        >
        <Boton slot="acciones" icon={GithubIcon} label="Codigo fuente de gearmoney en GitHub" href="https://github.com/RainBWP/gearmoney" newTab />
    </TarjetaGrande>
</section>
